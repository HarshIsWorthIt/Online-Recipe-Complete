<%@ page import="java.util.List,java.util.Map,com.recipely.model.Recipe,com.recipely.model.User,com.recipely.util.HtmlUtil" %>
<% List<Recipe> recipes = (List<Recipe>) request.getAttribute("recipes"); Map<String,Long> metrics=(Map<String,Long>) request.getAttribute("metrics"); User user=(User) request.getAttribute("user"); String flash=(String) request.getAttribute("flash"); String ctx=request.getContextPath(); %>
<!doctype html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Recipely</title><link rel="stylesheet" href="<%=ctx%>/assets/app.css"></head><body>
<nav class="nav"><a class="brand" href="<%=ctx%>/"><span>R</span>recipely</a><div class="nav-links"><a href="<%=ctx%>/">Discover</a><% if(user != null && user.canSubmitRecipes()){ %><a class="button secondary" href="<%=ctx%>/recipes/create">Share a recipe</a><% } %><% if(user != null && user.canModerateRecipes()){ %><a href="<%=ctx%>/admin">Admin</a><% } %><% if(user == null){ %><a class="button" href="<%=ctx%>/auth?mode=login">Sign in</a><% }else{ %><span><%=HtmlUtil.escape(user.getName())%></span><form method="post" action="<%=ctx%>/logout"><button class="button secondary">Log out</button></form><% } %></div></nav>
<main class="container"><% if(flash != null){ %><div class="notice"><%=HtmlUtil.escape(flash)%></div><% } %>
<section class="hero"><div><div class="eyebrow">Java Web Recipe Platform</div><h1>Share a recipe. <em>Find a favourite.</em></h1><p>Recipely brings contributors, explorers and administrators together through a moderated recipe-sharing community with JDBC persistence and Servlet-based web integration.</p><% if(user == null){ %><a class="button" href="<%=ctx%>/auth?mode=register">Create an account</a><% } %></div><div class="hero-visual"><div class="world">🍲</div><div><b>World Kitchen</b><p>Filter recipes by nation, taste and time.</p></div></div></section>
<section class="page-header"><div><div class="eyebrow">Discover recipes</div><h1>Cook something good</h1><p><%=metrics.getOrDefault("approved",0L)%> approved recipes shared by <%=metrics.getOrDefault("users",0L)%> members.</p></div></section>
<form class="search" method="get" action="<%=ctx%>/"><label class="field wide-search"><input name="q" placeholder="Search recipe or ingredient" value="<%=HtmlUtil.escape(request.getParameter("q"))%>"></label><label class="field"><select name="nation"><option value="">Any nation</option><option>India</option><option>Japan</option><option>Greece</option></select></label><label class="field"><select name="taste"><option value="">Any taste</option><option>Bold &amp; spicy</option><option>Deeply savoury</option><option>Bright &amp; tangy</option></select></label><label class="field"><select name="time"><option value="">Any time</option><option value="30">Under 30 min</option><option value="60">Under 60 min</option></select></label><button class="button">Search</button></form>
<div class="grid"><% if(recipes.isEmpty()){ %><div class="empty">No recipes match these filters.</div><% } for(Recipe recipe:recipes){ %><article class="card"><span class="tag"><%=HtmlUtil.escape(recipe.getCategory())%></span> <span class="tag origin"><%=HtmlUtil.escape(recipe.getNation())%></span><h3><%=HtmlUtil.escape(recipe.getTitle())%></h3><p><%=HtmlUtil.escape(recipe.getDescription())%></p><div class="meta"><%=recipe.getTotalMinutes()%> min · <%=HtmlUtil.escape(recipe.getTaste())%><br>Shared by <%=HtmlUtil.escape(recipe.getContributorName())%></div></article><% } %></div>
</main><footer class="footer">Recipely · Java Servlet and JDBC demonstration project</footer></body></html>
