<%@ page import="com.recipely.util.HtmlUtil" %>
<% String mode=(String)request.getAttribute("mode"); String error=(String)request.getAttribute("error"); String flash=(String)request.getAttribute("flash"); String ctx=request.getContextPath(); boolean register="register".equals(mode); %>
<!doctype html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%=register?"Register":"Sign in"%> · Recipely</title><link rel="stylesheet" href="<%=ctx%>/assets/app.css"></head><body>
<nav class="nav"><a class="brand" href="<%=ctx%>/"><span>R</span>recipely</a></nav><main class="container"><section class="form-card"><div class="eyebrow"><%=register?"Join the community":"Welcome back"%></div><h1><%=register?"Create your account":"Sign in to Recipely"%></h1><p>Use the demo accounts from the README or create a new explorer or contributor account.</p><% if(error!=null){ %><div class="notice error"><%=HtmlUtil.escape(error)%></div><% } %><% if(flash!=null){ %><div class="notice"><%=HtmlUtil.escape(flash)%></div><% } %>
<form method="post" action="<%=ctx%>/auth" class="form-grid"><input type="hidden" name="action" value="<%=register?"register":"login"%>"><% if(register){ %><label class="wide"><span class="label">Name</span><span class="field"><input required name="name" minlength="2" placeholder="Your name"></span></label><% } %><label class="wide"><span class="label">Email</span><span class="field"><input required name="email" type="email" placeholder="you@example.com"></span></label><label class="wide"><span class="label">Password</span><span class="field"><input required name="password" type="password" minlength="8" placeholder="At least 8 characters"></span></label><% if(register){ %><label class="wide"><span class="label">Role</span><span class="field"><select name="role"><option value="USER">General user</option><option value="CONTRIBUTOR">Recipe contributor</option><option value="EXPLORER">Recipe explorer</option></select></span></label><% } %><div class="wide"><button class="button"><%=register?"Create account":"Sign in"%></button> <a class="button secondary" href="<%=ctx%>/auth?mode=<%=register?"login":"register"%>"><%=register?"I already have an account":"Create an account"%></a></div></form></section></main></body></html>
