<%@ page import="com.recipely.model.User,com.recipely.util.HtmlUtil" %>
<% User user=(User)request.getAttribute("user"); String error=(String)request.getAttribute("error"); String ctx=request.getContextPath(); %>
<!doctype html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Share a recipe · Recipely</title><link rel="stylesheet" href="<%=ctx%>/assets/app.css"></head><body>
<nav class="nav"><a class="brand" href="<%=ctx%>/"><span>R</span>recipely</a><div class="nav-links"><a href="<%=ctx%>/">Discover</a><span><%=HtmlUtil.escape(user.getName())%></span></div></nav><main class="container"><section class="page-header"><div><div class="eyebrow">Contributor workspace</div><h1>Share a recipe</h1><p>Contributors submit recipes for administrator approval.</p></div></section><section class="form-card"><% if(error!=null){ %><div class="notice error"><%=HtmlUtil.escape(error)%></div><% } %><form method="post" action="<%=ctx%>/recipes/create" class="form-grid"><label class="wide"><span class="label">Recipe title</span><span class="field"><input required name="title" minlength="3" placeholder="e.g. Lemon chickpea pasta"></span></label><label class="wide"><span class="label">Description</span><span class="field"><textarea name="description" placeholder="What makes this recipe special?"></textarea></span></label><label><span class="label">Category</span><span class="field"><select name="category"><option>Breakfast</option><option>Lunch</option><option selected>Dinner</option><option>Snack</option><option>Dessert</option></select></span></label><label><span class="label">Cuisine</span><span class="field"><input required name="cuisine" placeholder="e.g. Indian"></span></label><label><span class="label">Nation</span><span class="field"><input required name="nation" placeholder="e.g. India"></span></label><label><span class="label">Taste</span><span class="field"><select name="taste"><option>Bold &amp; spicy</option><option>Deeply savoury</option><option>Bright &amp; tangy</option><option>Fresh &amp; herby</option><option>Sweet &amp; fruity</option></select></span></label><label><span class="label">Prep minutes</span><span class="field"><input required min="0" value="10" name="prepMinutes" type="number"></span></label><label><span class="label">Cook minutes</span><span class="field"><input required min="0" value="20" name="cookMinutes" type="number"></span></label><label class="wide"><span class="label">Ingredients</span><span class="field"><textarea required name="ingredients" placeholder="One ingredient per line"></textarea></span></label><label class="wide"><span class="label">Instructions</span><span class="field"><textarea required name="instructions" placeholder="One step per line"></textarea></span></label><div class="wide"><button class="button">Submit recipe</button> <a class="button secondary" href="<%=ctx%>/">Cancel</a></div></form></section></main></body></html>
