<%@ page import="java.util.List,java.util.Map,com.recipely.model.Recipe,com.recipely.model.User,com.recipely.util.HtmlUtil" %>
<% List<Recipe> pending=(List<Recipe>)request.getAttribute("pendingRecipes"); Map<String,Long> metrics=(Map<String,Long>)request.getAttribute("metrics"); User user=(User)request.getAttribute("user"); String ctx=request.getContextPath(); %>
<!doctype html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Admin console · Recipely</title><link rel="stylesheet" href="<%=ctx%>/assets/app.css"></head><body>
<nav class="nav"><a class="brand" href="<%=ctx%>/"><span>R</span>recipely</a><div class="nav-links"><a href="<%=ctx%>/">Discover</a><span><%=HtmlUtil.escape(user.getName())%></span></div></nav><main class="container"><section class="page-header"><div><div class="eyebrow">Administrator console</div><h1>Content moderation</h1><p>Review submitted recipes and monitor the platform.</p></div></section><section class="admin-stats"><div class="stat"><b><%=metrics.getOrDefault("users",0L)%></b><span>Registered users</span></div><div class="stat"><b><%=metrics.getOrDefault("approved",0L)%></b><span>Approved recipes</span></div><div class="stat"><b><%=metrics.getOrDefault("pending",0L)%></b><span>Pending reviews</span></div></section><% if(pending.isEmpty()){ %><div class="empty">No recipes are waiting for moderation.</div><% }else{ %><table class="table"><thead><tr><th>Recipe</th><th>Contributor</th><th>Nation</th><th>Action</th></tr></thead><tbody><% for(Recipe recipe:pending){ %><tr><td><b><%=HtmlUtil.escape(recipe.getTitle())%></b><br><small><%=HtmlUtil.escape(recipe.getDescription())%></small></td><td><%=HtmlUtil.escape(recipe.getContributorName())%></td><td><%=HtmlUtil.escape(recipe.getNation())%></td><td><form method="post" action="<%=ctx%>/admin"><input type="hidden" name="recipeId" value="<%=recipe.getId()%>"><button class="button" name="status" value="APPROVED">Approve</button> <button class="button secondary" name="status" value="REJECTED">Reject</button></form></td></tr><% } %></tbody></table><% } %></main></body></html>
